---
const currentYear = new Date().getFullYear();
---

<footer class="bg-dark text-white mt-5 py-5">
  <div class="container">
    <div class="row">
      <!-- SOL SÜTUN: Marka, Telif, Sitemap ve Sosyal Medya -->
      <div class="col-lg-5 col-md-12 mb-4 mb-lg-0 text-center text-lg-left">
        <h5 class="text-uppercase mb-3 font-weight-bold text-white">
          Deniz Mekanik
        </h5>
        <p class="mb-3 text-white-50 small">
          &copy; {currentYear} Tüm Hakları Saklıdır.
        </p>

        <!-- Sosyal Medya İkonları (Sola alındı) -->
        <div class="mb-3">
          <a
            href="https://www.facebook.com/denizmekanik"
            class="text-white mr-3"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"><i class="fab fa-facebook-f"></i></a
          >
          <a
            href="https://www.instagram.com/denizmekanik"
            class="text-white mr-3"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"><i class="fab fa-instagram"></i></a
          >
          <a
            href="https://www.linkedin.com/in/deniz-mekanik-8816699a/"
            class="text-white mr-3"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a
          >
          <a
            href="https://www.youtube.com/@DenizMekanik"
            class="text-white"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"><i class="fab fa-youtube"></i></a
          >
        </div>

        <!-- Sitemap Linki (Düzeltildi) -->
        <div>
          <a
            href="/sitemap-0.xml"
            class="text-white-50 small text-decoration-none hover-light"
          >
            <i class="fas fa-sitemap mr-1"></i> Site Haritası
          </a>
        </div>
      </div>

      <!-- SAĞ SÜTUN: SEO Odaklı Hizmet Linkleri -->
      <div
        class="col-lg-7 col-md-12 text-center text-lg-right d-flex flex-column justify-content-center"
      >
        <h6
          class="text-uppercase mb-3 font-weight-bold text-white border-bottom d-inline-block mx-auto mx-lg-0 ml-lg-auto pb-1"
          style="width: fit-content; border-color: #6c757d !important;"
        >
          Öne Çıkan Hizmetlerimiz
        </h6>
        <ul class="list-unstyled mb-0">
          <li class="mb-2">
            <a
              href="/proje/yuk-asansoru-vinc-sistemleri-cozumleri"
              class="text-white footer-seo-link"
            >
              <i class="fas fa-chevron-right small mr-2 d-lg-none"></i>Yük
              Asansörü İmalatı ve Bakım Servisi
            </a>
          </li>
          <li class="mb-2">
            <a
              href="/proje/torna-bohrwerk-talasli-imalat-genel"
              class="text-white footer-seo-link"
            >
              <i class="fas fa-chevron-right small mr-2 d-lg-none"></i>Torna &
              Bohrwerk: Ağır Sanayi İçin Fason Talaşlı İmalat
            </a>
          </li>
          <li>
            <a
              href="/proje/disli-imalati-hassas-taslama-genel"
              class="text-white footer-seo-link"
            >
              <i class="fas fa-chevron-right small mr-2 d-lg-none"></i>Özel
              Dişli İmalatı, Tamiri ve Hassas Taşlama Hizmetleri
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</footer>

<!-- === GÜNCELLENMİŞ SABİT İLETİŞİM BLOĞU (Aynı kaldı) === -->
<div class="fixed-contact-buttons">
  <a
    href="https://wa.me/905326948116?text=Merhaba%20sipariş%20vermek%20istiyorum"
    class="contact-button whatsapp"
    target="_blank"
    rel="noopener noreferrer"
  >
    <i class="fab fa-whatsapp"></i>
    <span>Sipariş vermek için tıklayın</span>
  </a>
  <a href="tel:+902165910113" class="contact-button phone">
    <i class="fas fa-phone-alt"></i>
    <span>Makine & Torna & Bohrwerk Destek Hattı</span>
  </a>
  <a href="tel:+905326948116" class="contact-button phone">
    <i class="fas fa-phone-alt"></i>
    <span>Vinç ve Asansör Servis & Satış Destek Hattı</span>
  </a>
  <a href="mailto:info@denizmekanik.com" class="contact-button email">
    <i class="fas fa-envelope"></i>
    <span>Satış & Destek Mail Adresi</span>
  </a>
</div>

<!-- === STİLLER === -->
<style>
  /* Footer Linkleri için Özel Efekt */
  .footer-seo-link {
    text-decoration: none;
    transition: all 0.3s ease;
    opacity: 0.8;
  }

  .footer-seo-link:hover {
    opacity: 1;
    color: #ffc107 !important; /* Hoverda sarımsı bir renk (Bootstrap warning rengi) ile dikkat çeker */
    padding-left: 5px; /* Hafif sağa kayma efekti */
  }

  .hover-light:hover {
    color: #fff !important;
  }

  /* === MASAÜSTÜ STİLLERİ (768px ve üzeri) === */
  .fixed-contact-buttons {
    position: fixed;
    bottom: 20px;
    left: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-button {
    display: flex;
    align-items: center;
    padding: 10px 16px;
    background-color: #343a40;
    color: white;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.3);
    gap: 10px;
    transition: background-color 0.3s ease-in-out;
  }

  .contact-button i {
    font-size: 20px;
    min-width: 20px;
  }

  .contact-button.whatsapp {
    background-color: #25d366;
  }
  .contact-button.phone {
    background-color: #007bff;
  }
  .contact-button.email {
    background-color: #6c757d;
  }

  .contact-button.whatsapp:hover {
    background-color: #128c7e;
  }
  .contact-button.phone:hover {
    background-color: #0056b3;
  }
  .contact-button.email:hover {
    background-color: #5a6268;
  }

  /* === MOBİL STİLLERİ (768px altı) === */
  @media (max-width: 767.98px) {
    .fixed-contact-buttons {
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      transform: translateY(0);
      flex-direction: row;
      gap: 0;
    }

    .contact-button {
      flex: 1;
      justify-content: center;
      padding: 12px 5px;
      font-size: 11px;
      border-radius: 0;
      transform: translateX(0);
      transition: background-color 0.2s;
      flex-direction: column;
      gap: 4px;
    }

    .contact-button i {
      transform: translateX(0);
      margin: 0;
      font-size: 20px;
    }
  }
</style>
