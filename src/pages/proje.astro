---
import Layout from "../layouts/Layout.astro";
import allProjects from "../data/projeler.json";

// Projeleri tersine çevir (En yeniden en eskiye)
const sortedProjects = [...allProjects].reverse();
---

<Layout title="Proje ve İmalatlar | Deniz Mekanik">
  <Fragment slot="head">
    <meta
      name="description"
      content="Deniz Mekanik olarak CNC boru büküm, egzoz sistemleri, çelik yapı, enerji projeleri ve daha birçok alanda profesyonel imalat hizmetleri sunuyoruz."
    />
    <meta
      name="keywords"
      content="Deniz Mekanik, proje, imalat, CNC boru büküm, egzoz, çelik yapı, enerji projeleri, demiryolu"
    />
    <link rel="canonical" href="https://www.denizmekanik.com/proje" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Deniz Mekanik - Proje ve İmalatlar" />
    <meta
      property="og:description"
      content="CNC boru büküm, egzoz sistemleri, çelik yapı ve enerji projeleri gibi birçok alanda profesyonel imalat hizmetleri."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.denizmekanik.com/proje" />
    <meta
      property="og:image"
      content="https://www.denizmekanik.com/assets/images/logo/logo.png"
    />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Deniz Mekanik - Proje ve İmalatlar" />
    <meta
      name="twitter:description"
      content="CNC boru büküm, egzoz sistemleri, çelik yapı ve enerji projeleri gibi birçok alanda profesyonel imalat hizmetleri."
    />
    <meta
      name="twitter:image"
      content="https://www.denizmekanik.com/assets/images/logo/logo.png"
    />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": "Deniz Mekanik - Proje ve İmalatlar",
        "description": "Deniz Mekanik'in tamamlanmış projeleri; CNC boru büküm, çelik yapı, enerji ve demiryolu projeleri.",
        "url": "https://www.denizmekanik.com/proje",
        "publisher": {
          "@type": "Organization",
          "name": "Deniz Mekanik",
          "url": "https://www.denizmekanik.com",
          "logo": "https://www.denizmekanik.com/assets/images/logo/logo.png"
        }
      }
    </script>
  </Fragment>

  <nav aria-label="breadcrumb" class="bg-light py-2">
    <div class="container-xl">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
        <li class="breadcrumb-item active" aria-current="page">Projeler</li>
      </ol>
    </div>
  </nav>

  <div class="container-xl mt-4">
    <div class="text-center mb-5">
      <h1 class="display-4 font-weight-bold">Proje ve İmalatlar</h1>
      <p class="lead">Modern Teknoloji ile Endüstriyel Çözümler</p>
    </div>

    <!-- ARAMA ALANI -->
    <div class="mb-4">
      <div class="input-group">
        <input
          style="text-align: center;"
          type="text"
          class="form-control"
          id="proje-filtre"
          placeholder="Proje ara (örnek: çelik, torna, istanbul)"
        />
        <div class="input-group-append">
          <button class="btn btn-outline-secondary" type="button">
            <i class="fas fa-search"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- PROJE LİSTESİ -->
    <div class="row justify-content-center">
      <div class="col-12" id="proje-container">
        {
          sortedProjects.map((proje) => (
            <div
              class="card mb-5 proje-karti buyuk-kart"
              data-title={proje.ad.toLocaleLowerCase("tr-TR")}
              data-desc={proje.seoAciklama.toLocaleLowerCase("tr-TR")}
            >
              <div class="row g-0">
                <div class="col-lg-5 col-md-4">
                  <div class="proje-resim-wrapper">
                    <img
                      src={proje.resim}
                      class="proje-resim"
                      alt={proje.ad}
                      loading="lazy"
                    />
                  </div>
                </div>
                <div class="col-lg-7 col-md-8">
                  <div class="card-body d-flex flex-column justify-content-between h-100">
                    <div>
                      <h5 class="card-title">{proje.ad}</h5>
                      <p class="card-text">{proje.seoAciklama}</p>
                    </div>
                    <div class="mt-auto pt-3">
                      <div class="row">
                        <div class="col-md-6 mb-2 mb-md-0">
                          <a
                            href={`/proje/${proje.slug}`}
                            class="btn btn-dark btn-lg btn-block"
                          >
                            Detayları Görüntüle
                          </a>
                        </div>
                        <div class="col-md-6">
                          <a
                            href="https://wa.me/905326948116?text=Merhaba%20projeler%20hakkında%20bilgi%20almak%20istiyorum"
                            class="btn btn-success btn-lg btn-block"
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            <i class="fab fa-whatsapp" /> İletişime Geçin
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- PAGINATION KONTROLLERİ -->
    <div class="row mt-4">
      <div class="col-12 d-flex justify-content-center">
        <nav aria-label="Page navigation">
          <ul class="pagination" id="pagination-controls">
            <!-- JS ile doldurulacak -->
          </ul>
        </nav>
      </div>
    </div>

    <!-- HİÇ SONUÇ BULUNAMADI UYARISI -->
    <div id="no-results" class="text-center mt-5" style="display: none;">
      <i class="fas fa-search fa-3x text-muted mb-3"></i>
      <h4 class="text-muted">Aradığınız kriterlere uygun proje bulunamadı.</h4>
    </div>
  </div>
</Layout>

<style>
  /* Pagination Buton Stilleri */
  .pagination .page-item.active .page-link {
    background-color: #343a40; /* Bootstrap dark */
    border-color: #343a40;
    color: white;
  }
  .pagination .page-link {
    color: #343a40;
    cursor: pointer;
  }
  .pagination .page-link:hover {
    background-color: #e9ecef;
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("proje-filtre");
    const container = document.getElementById("proje-container");
    const allCards = Array.from(document.querySelectorAll(".proje-karti"));
    const paginationControls = document.getElementById("pagination-controls");
    const noResultsMsg = document.getElementById("no-results");

    // === AYARLAR ===
    const ITEMS_PER_PAGE = 10; // İSTEĞİN ÜZERİNE 10 YAPILDI
    let currentPage = 1;
    let filteredCards = [...allCards];

    // === 1. FONKSİYON: Türkçe Karakter Normalizasyonu ===
    const normalizeText = (text) => {
      return text.toLocaleLowerCase("tr-TR").replace(/ı/g, "i");
    };

    // === 2. FONKSİYON: Listeyi Güncelle ===
    function updateDisplay() {
      const totalPages = Math.ceil(filteredCards.length / ITEMS_PER_PAGE);

      if (currentPage > totalPages) currentPage = 1;
      if (currentPage < 1) currentPage = 1;

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = startIndex + ITEMS_PER_PAGE;

      allCards.forEach((card) => (card.style.display = "none"));

      const cardsToShow = filteredCards.slice(startIndex, endIndex);
      cardsToShow.forEach((card) => (card.style.display = "block"));

      if (filteredCards.length === 0) {
        noResultsMsg.style.display = "block";
      } else {
        noResultsMsg.style.display = "none";
      }

      renderPagination(totalPages);
    }

    // === 3. FONKSİYON: Akıllı Pagination Oluştur (GÜNCELLENDİ) ===
    function renderPagination(totalPages) {
      paginationControls.innerHTML = "";
      if (totalPages <= 1) return;

      // Yardımcı Fonksiyon: Sayfa Numarası Ekleme
      const createPageItem = (page, isActive = false) => {
        const li = document.createElement("li");
        li.className = `page-item ${isActive ? "active" : ""}`;
        li.innerHTML = `<a class="page-link" href="#">${page}</a>`;
        li.onclick = (e) => {
          e.preventDefault();
          if (currentPage !== page) {
            currentPage = page;
            updateDisplay();
            scrollToTop();
          }
        };
        return li;
      };

      // Yardımcı Fonksiyon: "..." Ekleme
      const createDots = () => {
        const li = document.createElement("li");
        li.className = "page-item disabled";
        li.innerHTML = `<span class="page-link">...</span>`;
        return li;
      };

      // < Önceki Sayfa Butonu
      const prevLi = document.createElement("li");
      prevLi.className = `page-item ${currentPage === 1 ? "disabled" : ""}`;
      prevLi.innerHTML = `<a class="page-link" href="#">&laquo;</a>`;
      prevLi.onclick = (e) => {
        e.preventDefault();
        if (currentPage > 1) {
          currentPage--;
          updateDisplay();
          scrollToTop();
        }
      };
      paginationControls.appendChild(prevLi);

      // === SAYFA NUMARALARI ALGORİTMASI ===
      // Hangi sayfaların gösterileceğini hesapla
      // Mantık: Her zaman 1. sayfa, Son sayfa ve mevcut sayfanın +-2 yanındakileri göster.
      const delta = 2; // Aktif sayfanın sağında ve solunda kaç sayı görünsün
      const range = [];
      const rangeWithDots = [];

      for (let i = 1; i <= totalPages; i++) {
        if (
          i === 1 ||
          i === totalPages ||
          (i >= currentPage - delta && i <= currentPage + delta)
        ) {
          range.push(i);
        }
      }

      let l;
      for (let i of range) {
        if (l) {
          if (i - l === 2) {
            // Eğer arada sadece 1 sayı boşluk varsa, o sayıyı direkt ekle (Örn: 1 ... 3 yerine 1 2 3 olsun)
            rangeWithDots.push(l + 1);
          } else if (i - l !== 1) {
            // Eğer boşluk büyükse "..." koy
            rangeWithDots.push("...");
          }
        }
        rangeWithDots.push(i);
        l = i;
      }

      // Hesaplanan diziyi HTML'e dök
      rangeWithDots.forEach((item) => {
        if (item === "...") {
          paginationControls.appendChild(createDots());
        } else {
          paginationControls.appendChild(
            createPageItem(item, item === currentPage)
          );
        }
      });

      // > Sonraki Sayfa Butonu
      const nextLi = document.createElement("li");
      nextLi.className = `page-item ${currentPage === totalPages ? "disabled" : ""}`;
      nextLi.innerHTML = `<a class="page-link" href="#">&raquo;</a>`;
      nextLi.onclick = (e) => {
        e.preventDefault();
        if (currentPage < totalPages) {
          currentPage++;
          updateDisplay();
          scrollToTop();
        }
      };
      paginationControls.appendChild(nextLi);
    }

    function scrollToTop() {
      const searchBox = document.querySelector(".input-group");
      if (searchBox) {
        searchBox.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    }

    searchInput.addEventListener("input", function () {
      const rawTerm = this.value.trim();
      const searchTerm = normalizeText(rawTerm);

      filteredCards = allCards.filter((card) => {
        const title = normalizeText(card.dataset.title || "");
        const desc = normalizeText(card.dataset.desc || "");
        return title.includes(searchTerm) || desc.includes(searchTerm);
      });

      currentPage = 1;
      updateDisplay();
    });

    updateDisplay();
  });
</script>
